x;--r16:16px;--sp4:4px;--sp8:8px;--sp12:12px;--sp16:16px;--sp20:20px;--sp24:24px;--sp32:32px;--sp40:40px;--tr:.25s cubic-bezier(.4,0,.2,1)}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;height:100%}\nbody{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",\"Segoe UI\",system-ui,Arial,sans-serif;font-size:16px;line-height:1.55;color:var(--tx);background:var(--bg);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}\na{color:inherit;text-decoration:none}\nimg{max-width:100%;display:block}\nbutton{font:inherit;color:inherit;background:transparent;border:0;cursor:pointer}\n.container{max-width:1160px;margin:0 auto;padding:0 16px}\n.app-nav{position:sticky;top:0;z-index:1000;background:rgba(0,0,0,.82);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid rgba(255,255,255,.06)}\n.nav-row{height:60px;display:flex;align-items:center;justify-content:space-between;gap:12px}\n.brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:-.01em}\n.brand-badge{width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#0a84ff 0%,#30d158 100%);box-shadow:0 4px 18px rgba(10,132,255,.35)}\n.brand span{font-size:18px}\n.nav-menu{display:flex;align-items:center;gap:2px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}\n.nav-menu::-webkit-scrollbar{display:none}\n.nav-link{padding:8px 12px;border-radius:10px;font-size:14px;opacity:.85;transition:opacity var(--tr),background var(--tr)}\n.nav-link:hover,.nav-link.active{opacity:1;background:rgba(255,255,255,.08)}\n.cta{display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;background:linear-gradient(135deg,#0a84ff 0%,#409cff 100%);color:#fff;font-weight:600;box-shadow:var(--shadow);transition:transform var(--tr),filter var(--tr)}\n.cta:hover{transform:translateY(-1px);filter:brightness(1.05)}\n.hero{padding:56px 0 28px;background:radial-gradient(1200px 500px at 50% -200px,rgba(10,132,255,.16),transparent 60%),radial-gradient(900px 500px at 20% -240px,rgba(48,209,88,.12),transparent 60%),radial-gradient(900px 500px at 80% -240px,rgba(191,90,242,.10),transparent 60%)}\n.hero-inner{display:grid;grid-template-columns:1.2fr .8fr;gap:32px;align-items:center}\n.h-title{font-size:42px;line-height:1.08;letter-spacing:-.02em}\n.h-sub{margin-top:12px;color:var(--tx2);font-size:18px}\n.h-actions{margin-top:22px;display:flex;gap:12px;flex-wrap:wrap}\n.ghost{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.02)}\n.card-row{margin-top:28px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n.card{padding:18px;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.08)}\n.card h3{font-size:16px;margin-bottom:6px}\n.card p{color:var(--tx2);font-size:14px}\n.section{padding:36px 0;border-top:1px solid rgba(255,255,255,.06)}\n.section h2{font-size:24px;margin-bottom:8px}\n.section p.lead{color:var(--tx2);margin-bottom:16px}\n.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}\n.tile{border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:16px;background:rgba(255,255,255,.03)}\n.tile h4{font-size:15px;margin-bottom:4px}\n.tile p{font-size:13px;color:var(--tx2)}\n.kv{display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:center}\n.kv strong{font-size:28px}\n.kv small{color:var(--tx2)}\n.table{width:100%;border-collapse:separate;border-spacing:0;border:1px solid rgba(255,255,255,.08);border-radius:12px;overflow:hidden}\n.table th,.table td{padding:12px 10px;text-align:left;font-size:14px}\n.table thead th{background:rgba(255,255,255,.06)}\n.table tbody tr:nth-child(odd){background:rgba(255,255,255,.02)}\n.badge{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);font-size:13px}\n.stack{display:flex;flex-direction:column;gap:10px}\n.inline{display:flex;flex-wrap:wrap;gap:10px;align-items:center}\n.input{width:100%;padding:12px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.03);color:var(--tx);outline:none;transition:border var(--tr),background var(--tr)}\n.input:focus{border-color:rgba(10,132,255,.6);background:rgba(255,255,255,.06)}\n.select{appearance:none}\n.footer{padding:24px 0;color:var(--tx2);text-align:center;border-top:1px solid rgba(255,255,255,.06)}\n@media (max-width:1024px){.hero-inner{grid-template-columns:1fr}.grid-4{grid-template-columns:repeat(2,1fr)}.card-row{grid-template-columns:repeat(2,1fr)}}\n@media (max-width:640px){.h-title{font-size:34px}.grid-4{grid-template-columns:1fr}.card-row{grid-template-columns:1fr}.nav-menu{display:none}}\n</style>\n<script src=\"\" integrity=\"sha512-6HrPqAvK+lZElIZ4mZ64fyxIBTsaX5zAFZg2V/2WT+iKPrFzTzvx6QAsLW2OaLwobhMYBog/+bvmIEEGXi0p1w==\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" defer></script>\n</head>\n<body>\n<nav class=\"app-nav\">\n  <div class=\"container nav-row\">\n    <span class=\"brand-badge\"></span><span>TiffyTime</span>\n    <div class=\"nav-menu\">\n      Funkci\u00f3k\n      Biztons\u00e1g\n      Gyorsas\u00e1g\n      Mobil\n      Regisztr\u00e1ci\u00f3\n      Ir\u00e1ny\u00edt\u00f3pult\n      \u00daj fizet\u00e9s\n      Fizet\u00e9si linkek\n      Tranzakci\u00f3k\n      Analitika\n    </div>\n    Kezd\u00e9s\n  </div>\n</nav>\n<header id=\"home\" class=\"hero\">\n  <div class=\"container hero-inner\">\n    <div>\n      <h1 class=\"h-title\">TiffyTime. Id\u0151alap\u00fa fizet\u00e9sek.</h1>\n      <p class=\"h-sub\">Fizess percek alapj\u00e1n. Egyszer\u0171 id\u0151k\u00f6vet\u00e9s \u00e9s azonnali fizet\u00e9sek Erste Bank integr\u00e1ci\u00f3val, Apple Pay \u00e9s Google Pay t\u00e1mogat\u00e1ssal.</p>\n      <div class=\"h-actions\">\n        Fi\u00f3k l\u00e9trehoz\u00e1sa\n        Tov\u00e1bb a r\u00e9szletekre\n      </div>\n      <div class=\"card-row\">\n        <div class=\"card\">\n          <h3>Biztons\u00e1gos</h3>\n          <p>PSD2 szerinti er\u0151s \u00fcgyf\u00e9l-hiteles\u00edt\u00e9s \u00e9s titkos\u00edtott adat\u00e1tvitel.</p>\n        </div>\n        <div class=\"card\">\n          <h3>Vill\u00e1mgyors</h3>\n          <p>Val\u00f3s idej\u0171 fizet\u00e9sfeldolgoz\u00e1s \u00e9s azonnali visszaigazol\u00e1s.</p>\n        </div>\n        <div class=\"card\">\n          <h3>Mobil-els\u0151</h3>\n          <p>Nat\u00edv Apple Pay \u00e9s Google Pay integr\u00e1ci\u00f3 a z\u00f6kken\u0151mentes \u00e9lm\u00e9ny\u00e9rt.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"card\">\n      <div class=\"stack\">\n        <div class=\"kv\"><strong>50ms</strong><small>\u00c1tlagos API v\u00e1laszid\u0151</small></div>\n        <div class=\"kv\"><strong>1.2s</strong><small>\u00c1tlagos fizet\u00e9si id\u0151</small></div>\n        <div class=\"kv\"><strong>99.99%</strong><small>Sikeres tranzakci\u00f3k ar\u00e1nya</small></div>\n      </div>\n    </div>\n  </div>\n</header>\n<section id=\"features\" class=\"section\">\n  <div class=\"container\">\n    <h2>Fizet\u00e9si m\u00f3dok minden ig\u00e9nyre</h2>\n    <p class=\"lead\">V\u00e1lassz a sz\u00e1modra legmegfelel\u0151bb fizet\u00e9si m\u00f3db\u00f3l.</p>\n    <div class=\"grid-4\">\n      <div class=\"tile\">\n        <h4>Erste Bank</h4>\n        <p>Biztons\u00e1gos banki \u00e1tutal\u00e1s.</p>\n      </div>\n      <div class=\"tile\">\n        <h4>Coinbase</h4>\n        <p>Kripto fizet\u00e9sek HUF-ban.</p>\n      </div>\n      <div class=\"tile\">\n        <h4>Apple Pay</h4>\n        <p>Touch ID vagy Face ID.</p>\n      </div>\n      <div class=\"tile\">\n        <h4>Google Pay</h4>\n        <p>Android fizet\u00e9s.</p>\n      </div>\n    </div>\n  </div>\n</section>\n<section id=\"security\" class=\"section\">\n  <div class=\"container\">\n    <h2>Bankszint\u0171 biztons\u00e1g</h2>\n    <p class=\"lead\">Az adataid v\u00e9delme a legfontosabb sz\u00e1munkra.</p>\n    <div class=\"card-row\">\n      <div class=\"card\">\n        <h3>PSD2 megfelel\u0151s\u00e9g</h3>\n        <p>A TiffyTime teljes m\u00e9rt\u00e9kben megfelel az Eur\u00f3pai Uni\u00f3 PSD2 el\u0151\u00edr\u00e1sainak a legmagasabb szint\u0171 online fizet\u00e9si biztons\u00e1g\u00e9rt.</p>\n      </div>\n      <div class=\"card\">\n        <h3>Er\u0151s \u00fcgyf\u00e9l-hiteles\u00edt\u00e9s</h3>\n        <div class=\"stack\">\n          <span class=\"badge\">Biometrikus azonos\u00edt\u00e1s</span>\n          <span class=\"badge\">PIN k\u00f3d vagy jelsz\u00f3</span>\n          <span class=\"badge\">Egyedi eszk\u00f6zazonos\u00edt\u00e1s</span>\n          <span class=\"badge\">SMS vagy push meger\u0151s\u00edt\u00e9s</span>\n        </div>\n      </div>\n      <div class=\"card\">\n        <h3>256-bites titkos\u00edt\u00e1s</h3>\n        <div class=\"stack\">\n          <span class=\"badge\">TLS 1.3 adat\u00e1tvitel</span>\n          <span class=\"badge\">End-to-end titkos\u00edt\u00e1s</span>\n          <span class=\"badge\">Titkos\u00edtott adatt\u00e1rol\u00e1s nyugalmi \u00e1llapotban</span>\n          <span class=\"badge\">Kriptogr\u00e1fiai jelsz\u00f3t\u00e1rol\u00e1s</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"section\" style=\"padding:24px 0 0 0;border:0\">\n      <h3>Erste Bank integr\u00e1ci\u00f3</h3>\n      <div class=\"card-row\">\n        <div class=\"card\">\n          <h4>OAuth 2.0</h4>\n          <p>Ipari szabv\u00e1ny\u00fa hiteles\u00edt\u00e9s.</p>\n        </div>\n        <div class=\"card\">\n          <h4>Consent</h4>\n          <p>Explicit felhaszn\u00e1l\u00f3i j\u00f3v\u00e1hagy\u00e1s.</p>\n        </div>\n        <div class=\"card\">\n          <h4>Read-only</h4>\n          <p>Csak olvas\u00e1si jogosults\u00e1g.</p>\n        </div>\n      </div>\n      <p class=\"lead\" style=\"margin-top:8px\">A TiffyTime soha nem t\u00e1rol banki bejelentkez\u00e9si adatokat; a hiteles\u00edt\u00e9s k\u00f6zvetlen\u00fcl az Erste Bank biztons\u00e1gos rendszer\u00e9n kereszt\u00fcl t\u00f6rt\u00e9nik.</p>\n    </div>\n  </div>\n</section>\n<section id=\"speed\" class=\"section\">\n  <div class=\"container\">\n    <h2>Vill\u00e1mgyors fizet\u00e9sek</h2>\n    <p class=\"lead\">Milliszekundumok alatt feldolgozzuk a tranzakci\u00f3idat.</p>\n    <div class=\"card-row\">\n      <div class=\"card\">\n        <h3>Val\u00f3s idej\u0171 feldolgoz\u00e1s</h3>\n        <p>High-performance infrastrukt\u00fara a leggyorsabb fizet\u00e9si \u00e9lm\u00e9ny\u00e9rt.</p>\n      </div>\n      <div class=\"card\">\n        <div class=\"kv\"><strong>50ms</strong><small>\u00c1tlagos API v\u00e1laszid\u0151</small></div>\n      </div>\n      <div class=\"card\">\n        <div class=\"kv\"><strong>1.2s</strong><small>\u00c1tlagos fizet\u00e9si id\u0151</small></div>\n      </div>\n      <div class=\"card\">\n        <div class=\"kv\"><strong>99.99%</strong><small>Sikeres tranzakci\u00f3k</small></div>\n      </div>\n    </div>\n  </div>\n</section>\n<section id=\"pwa\" class=\"section\">\n  <div class=\"container\">\n    <h2>Mobil-els\u0151 megk\u00f6zel\u00edt\u00e9s</h2>\n    <p class=\"lead\">Nat\u00edv app \u00e9lm\u00e9ny minden platformon.</p>\n    <div class=\"grid-4\">\n      <div class=\"tile\">\n        <h4>Progressz\u00edv Webapp</h4>\n        <p>Teljes PWA \u00e9lm\u00e9ny telep\u00edt\u00e9s n\u00e9lk\u00fcl.</p>\n      </div>\n      <div class=\"tile\">\n        <h4>Apple Pay</h4>\n        <p>G\u00f6rd\u00fcl\u00e9keny fizet\u00e9s iOS eszk\u00f6z\u00f6k\u00f6n.</p>\n      </div>\n      <div class=\"tile\">\n        <h4>Google Pay</h4>\n        <p>Z\u00f6kken\u0151mentes Android t\u00e1mogat\u00e1s.</p>\n      </div>\n      <div class=\"tile\">\n        <h4>Reszponz\u00edv UI</h4>\n        <p>Gyors \u00e9s akad\u00e1lymentes kezel\u0151fel\u00fclet.</p>\n      </div>\n    </div>\n  </div>\n</section>\n<section id=\"register\" class=\"section\">\n  <div class=\"container\">\n    <h2>Regisztr\u00e1ci\u00f3</h2>\n    <p class=\"lead\">Hozz l\u00e9tre egy fi\u00f3kot a modern fizet\u00e9si megold\u00e1sok haszn\u00e1lat\u00e1hoz.</p>\n    <form class=\"card stack\" onsubmit=\"return false\">\n      <input class=\"input\" type=\"text\" inputmode=\"text\" autocomplete=\"name\" placeholder=\"N\u00e9v\">\n      <input class=\"input\" type=\"email\" inputmode=\"email\" autocomplete=\"email\" placeholder=\"E-mail\">\n      <input class=\"input\" type=\"password\" autocomplete=\"new-password\" placeholder=\"Jelsz\u00f3\">\n      <div class=\"inline\">\n        <button class=\"cta\" id=\"registerBtn\">Fi\u00f3k l\u00e9trehoz\u00e1sa</button>\n        M\u00e1r van fi\u00f3kod? Jelentkezz be\n      </div>\n    </form>\n  </div>\n</section>\n<section id=\"dashboard\" class=\"section\">\n  <div class=\"container\">\n    <h2>Ir\u00e1ny\u00edt\u00f3pult</h2>\n    <p class=\"lead\">\u00dcdv\u00f6zl\u00fcnk.</p>\n    <div class=\"card-row\">\n      <div class=\"card\">\n        <h3>Gyors m\u0171veletek</h3>\n        <div class=\"inline\" style=\"margin-top:10px\">\n          \u00daj fizet\u00e9s\n          \u00daj link\n        </div>\n      </div>\n      <div class=\"card\" style=\"grid-column:span 2\">\n        <h3>Legut\u00f3bbi fizet\u00e9sek</h3>\n        <table class=\"table\" style=\"margin-top:10px\">\n          <thead><tr><th>\u00d6sszeg</th><th>C\u00edmzett</th><th>M\u00f3dszer</th><th>St\u00e1tusz</th><th>D\u00e1tum</th></tr></thead>\n          <tbody id=\"recentPayments\"><tr><td colspan=\"5\">Bet\u00f6lt\u00e9s\u2026</td></tr></tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n</section>\n<section id=\"new-payment\" class=\"section\">\n  <div class=\"container\">\n    <h2>\u00daj fizet\u00e9s</h2>\n    <p class=\"lead\">V\u00e1lassz fizet\u00e9si m\u00f3dot \u00e9s add meg a sz\u00fcks\u00e9ges adatokat.</p>\n    <form class=\"card stack\" onsubmit=\"return false\">\n      <select class