()\n    S.K = abc.K\n    S.Kp = abc.Kp\n    S.s = zeros(Int32, S.Kp, S.Kp)\n    S.isval = ones(Int32, S.Kp)\n    S.abc_r = abc\n    S.outorder = String(collect(abc.sym[1:S.K]))\n    S.nc = S.K\n    S.name = \"\"\n    S.path = \"\"\n    return S\nend\n\nfunction esl_scorematrix_SetIdentity(S::ESL_SCOREMATRIX)\n    fill!(S.s, 0)\n    for a in 1:S.K\n        S.s[a,a] = 1\n    end\n    for x in 1:S.K\n        S.isval[x] = TRUE\n    end\n    for x in (S.abc_r.K+1):S.Kp\n        S.isval[x] = FALSE\n    end\n    S.outorder = String(collect(S.abc_r.sym[1:S.K]))\n    S.nc = S.K\n    return eslOK\nend\n\nfunction esl_scorematrix_SetFromProbs(S::ESL_SCOREMATRIX, lambda::Float64, P::ESL_DMATRIX, fi::Vector{Float64}, fj::Vector{Float64})\n    for i in 1:S.abc_r.K\n        for j in 1:S.abc_r.K\n            sc = log(P.mx[i,j] / (fi[i] * fj[j])) / lambda\n            S.s[i,j] = Int32(round(sc))\n        end\n    end\n    for i in 1:S.abc_r.K\n        S.isval[i] = TRUE\n    end\n    S.nc = S.abc_r.K\n    S.outorder = String(collect(S.abc_r.sym[1:S.abc_r.K]))\n    return eslOK\nend\n\nfunction esl_scorematrix_Copy(src::ESL_SCOREMATRIX)\n    dest = ESL_SCOREMATRIX()\n    dest.K = src.K\n    dest.Kp = src.Kp\n    dest.s = copy(src.s)\n    dest.isval = copy(src.isval)\n    dest.abc_r = src.abc_r\n    dest.outorder = src.outorder\n    dest.nc = src.nc\n    dest.name = src.name\n    dest.path = src.path\n    return dest\nend\n\nfunction esl_scorematrix_Clone(S::ESL_SCOREMATRIX)\n    return esl_scorematrix_Copy(S)\nend\n\nfunction esl_scorematrix_Compare(S1::ESL_SCOREMATRIX, S2::ESL_SCOREMATRIX)\n    if S1.K != S2.K || S1.Kp != S2.Kp\n        return eslFAIL\n    end\n    if S1.s != S2.s\n        return eslFAIL\n    end\n    return eslOK\nend\n\nfunction esl_scorematrix_CompareCanon(S::ESL_SCOREMATRIX, Kp::Int32, s::Matrix{Int32})\n    if S.Kp != Kp\n        return eslFAIL\n    end\n    if S.s != s\n        return eslFAIL\n    end\n    return eslOK\nend\n\nfunction esl_scorematrix_Max(S::ES